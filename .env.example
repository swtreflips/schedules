# Copy to .env. All three are PUBLIC build-time values — Vite inlines anything VITE_*.
# Never put a service_role key here.

VITE_SUPABASE_URL=https://your-rates-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The shared geo brain. The app calls ${VITE_GEOAPI_URL}/api/geocode with the signed-in
# user's Supabase access token; only authenticated callers spend the upstream quota.
VITE_GEOAPI_URL=https://geoapi-next.vercel.app
